# Arms control config (see config/ for available configs)
# For Quest: openarm_quest_teleop.yaml
# For Pico 4: openarm_pico_teleop.yaml
ARMS_CONTROL_CONFIG_FILE=openarm_pico_teleop.yaml

# ROS Domain ID (0-232). Isolates ROS2 traffic between workcells on the same
# network. If unset, communication is restricted to localhost.
ROS_DOMAIN_ID=205

# CycloneDDS distributed communication (e.g. GPU PC for inference).
# When enabled, RMW switches to CycloneDDS with peer discovery.
ENABLE_CYCLONEDDS=false
CYCLONEDDS_PEER_IP=192.168.1.150
GRAFANA_LOKI_HOST=logs-prod-043.grafana.net
GRAFANA_LOKI_USER=1625665
GRAFANA_LOKI_API_KEY=

# VR teleop
# Quest: true  (ros2 handles teleop natively).
# Pico4: false (pico4-teleop handles IK + arm control; ros2 must NOT also launch quest_teleop).
ENABLE_VR_TELEOP=false
# Position scaling for teleop controller input
TELEOP_POSITION_SCALE=1.0
# Headset type: quest | pico4
VR_HEADSET_TYPE=pico4

# XRoboToolkit PC Service (required when VR_HEADSET_TYPE=pico4)
# XRPC_SERVICE_PORT: port the C++ PC Service binds for the Pico 4 headset (TCP/UDP)
# XRPC_GRPC_PORT:    port the vr-pico4-bridge uses to poll the PC Service gRPC API
XRPC_SERVICE_HOST=localhost
XRPC_SERVICE_PORT=9100
XRPC_GRPC_PORT=9200

# Camera settings
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=60

# Camera controls
CAMERA_BRIGHTNESS=50
CAMERA_CONTRAST=0
CAMERA_SATURATION=60
CAMERA_HUE=0
CAMERA_GAMMA=100
CAMERA_GAIN=100
CAMERA_POWER_LINE_FREQUENCY=2
CAMERA_SHARPNESS=0
CAMERA_BACKLIGHT_COMPENSATION=64
CAMERA_AUTO_WHITE_BALANCE=true
CAMERA_WHITE_BALANCE=4600
CAMERA_AUTOEXPOSURE=true
CAMERA_EXPOSURE=156
CAMERA_AUTOFOCUS=true
CAMERA_FOCUS=110
CAMERA_ZOOM_ABSOLUTE=0
